func bytesResult(r core.Result) ([]byte, error) {
	if r.Is_Err() {
		return nil, eventresidue.Error(r.Dtor_code(), eventresidue.String(r.Dtor_message()), nil)
	}
	return eventresidue.Bytes(r.Dtor_value().(_dafny.Sequence)), nil
}
