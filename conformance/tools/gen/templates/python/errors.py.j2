class {{ c.native }}Error(EHBPError):
    code = Code.{{ c.value }}
{% endfor %}


def code_of(err: BaseException) -> Optional[Code]:
    """The canonical code of any raised value, or None for a non-EHBP error."""
    return err.code if isinstance(err, EHBPError) else None


def error_for(code: str, message: str) -> EHBPError:
    """The exception class for a canonical code string."""
    for cls in EHBPError.__subclasses__():
        if cls.code.value == code:
            return cls(message)
    raise ValueError(f"unknown code {code}")
